{
  "name": "azhen-desktop-pet",
  "version": "0.2.0",
  "private": true,
  "description": "Cross-platform Agent desktop pet with replaceable animated assets.",
  "main": "app/main.js",
  "author": "Azhen Desktop Pet contributors",
  "scripts": {
    "start": "electron .",
    "check": "node --check app/main.js && node --check app/preload.js && node --check app/桌宠运行时.js",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win nsis portable --publish never"
  },
  "build": {
    "appId": "com.azhen.desktop-pet",
    "productName": "Azhen Desktop Pet",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "app/main.js"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon/icon.icns"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12"
  }
}
