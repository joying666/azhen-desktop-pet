{
  "schema": "azhen-desktop-pet-state-map/v1",
  "project": "可替换素材桌宠包",
  "assetBase": "./",
  "defaultState": "working",
  "video": {
    "width": 960,
    "height": 960,
    "fps": 24,
    "format": "gif-webp-webm-apng-png-mp4"
  },
  "states": {
    "working": {
      "label": "任务进行中",
      "processStatus": ["running", "streaming", "tool_running", "progress"],
      "file": "./任务进行中_无缝循环",
      "loop": true,
      "eventAliases": [
        "agent.task.started",
        "agent.task.running",
        "agent.task.progress",
        "agent.response.streaming",
        "agent.tool.running",
        "codex.task.started",
        "codex.task.running",
        "codex.turn.running",
        "codex.response.streaming",
        "codex.tool.running",
        "codex.exec.running",
        "claude.task.started",
        "claude.task.running",
        "claude.response.streaming",
        "claude.tool.running",
        "claude_code.task.running",
        "claudecode.task.running"
      ]
    },
    "done": {
      "label": "任务完成",
      "processStatus": ["completed", "done", "output_ready"],
      "file": "./任务完成",
      "loop": false,
      "holdMs": 4200,
      "autoReturnTo": "paused",
      "eventAliases": [
        "agent.task.done",
        "agent.task.completed",
        "agent.output.ready",
        "codex.task.done",
        "codex.task.completed",
        "codex.turn.completed",
        "codex.response.completed",
        "codex.output.ready",
        "claude.task.done",
        "claude.task.completed",
        "claude.response.completed",
        "claude.output.ready",
        "claude_code.task.completed",
        "claudecode.task.completed"
      ]
    },
    "failed": {
      "label": "任务失败",
      "processStatus": ["failed", "error"],
      "file": "./任务失败",
      "loop": false,
      "holdMs": 4200,
      "autoReturnTo": "paused",
      "eventAliases": [
        "agent.task.failed",
        "agent.task.error",
        "agent.tool.error",
        "codex.task.failed",
        "codex.task.error",
        "codex.tool.error",
        "codex.exec.failed",
        "claude.task.failed",
        "claude.task.error",
        "claude.tool.error",
        "claude_code.task.failed",
        "claudecode.task.failed"
      ]
    },
    "paused": {
      "label": "任务暂停/休息",
      "processStatus": ["paused", "idle", "waiting_user", "waiting_approval", "blocked"],
      "file": "./任务暂停_休息_无缝循环",
      "loop": true,
      "eventAliases": [
        "agent.task.paused",
        "agent.waiting.user",
        "agent.waiting.approval",
        "agent.idle",
        "agent.blocked",
        "codex.task.paused",
        "codex.waiting.user",
        "codex.waiting.approval",
        "codex.goal.blocked",
        "codex.idle",
        "claude.task.paused",
        "claude.waiting.user",
        "claude.waiting.approval",
        "claude.needs_input",
        "claude.idle",
        "claude_code.waiting.user",
        "claudecode.waiting.user"
      ]
    },
    "water": {
      "label": "喝水提醒",
      "processStatus": ["scheduled_reminder"],
      "file": "./喝水提醒",
      "loop": true,
      "holdMs": 120000,
      "autoReturnTo": "working",
      "eventAliases": ["reminder.water.hourly"]
    }
  },
  "reminders": {
    "water": {
      "enabled": true,
      "intervalMinutes": 60,
      "state": "water",
      "workHours": {
        "start": "09:00",
        "end": "18:00"
      }
    },
    "rest": {
      "enabled": true,
      "state": "paused",
      "timeRanges": [
        {
          "start": "12:00",
          "end": "13:00"
        }
      ]
    }
  }
}
